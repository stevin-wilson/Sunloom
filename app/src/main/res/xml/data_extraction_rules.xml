<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only preferences and the SQLite database file are included; the transient WAL/SHM files and the image
         directories are excluded. The database is checkpointed (WAL folded into the main file) when the app stops
         and at the end of every background run, so a backup taken while the app is closed holds the latest writes. -->
    <cloud-backup>
        <include domain="sharedpref" path="sunloom_preferences.xml" />
        <include domain="database" path="sunloom_library.db" />
        <exclude domain="database" path="sunloom_library.db-wal" />
        <exclude domain="database" path="sunloom_library.db-shm" />
        <exclude domain="database" path="sunloom_library.db-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sunloom_preferences.xml" />
        <include domain="database" path="sunloom_library.db" />
        <exclude domain="database" path="sunloom_library.db-wal" />
        <exclude domain="database" path="sunloom_library.db-shm" />
        <exclude domain="database" path="sunloom_library.db-journal" />
    </device-transfer>
</data-extraction-rules>
